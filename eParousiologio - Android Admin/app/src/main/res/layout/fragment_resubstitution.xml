<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parent_background"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="56dp"
    tools:context=".view.fragment.ResubstitutionFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchStudentsMCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/main_menu_button"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/primary_color_4"
        app:strokeWidth="1dp">

        <SearchView
            android:id="@+id/studentSearchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:inputType="number"
            android:iconifiedByDefault="false"
            android:queryHint="@string/search_hint"
            android:textColor="@color/text_color"
            app:iconifiedByDefault="false" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/noStudentsFoundMTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/no_students_found"
        android:visibility="gone"
        android:textColor="@color/text_color"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/searchStudentsMCV"
        app:layout_constraintStart_toStartOf="@+id/searchStudentsMCV"
        app:layout_constraintTop_toBottomOf="@+id/searchStudentsMCV" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/studentsSearchResultsRV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:splitMotionEvents="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchStudentsMCV" />

</androidx.constraintlayout.widget.ConstraintLayout>
