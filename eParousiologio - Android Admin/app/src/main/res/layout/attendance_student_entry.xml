<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/attendanceStudentEntryRootMCV"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/main_menu_button"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:rippleColor="?colorControlHighlight"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/attendanceStudentEntryFullNameMTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/main_menu_button_text_color"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/attendanceStudentEntryAEMMTV"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="4dp"
            tools:text="Ονοματεπώνυμο" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/attendanceStudentEntryAEMMTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/main_menu_button_text_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/attendanceStudentEntryOKCB"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="12345" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/attendanceStudentEntryOKCB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/main_menu_button_text_color"
            app:layout_constraintBottom_toBottomOf="@+id/attendanceStudentEntryAEMMTV"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/attendanceStudentEntryAEMMTV" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
